{
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "chat.message.recalled",
  "description": "Emitted when a sender retracts a message. The message content is replaced with an empty string and `is_recalled` is set to true on all clients.",
  "type": "object",
  "required": ["event", "version", "payload", "metadata"],
  "properties": {
    "event": { "type": "string", "const": "chat.message.recalled" },
    "version": { "type": "string", "const": "1.0" },
    "payload": {
      "type": "object",
      "required": ["message_id", "conversation_id", "recalled_at"],
      "properties": {
        "message_id":      { "type": "string", "format": "uuid" },
        "conversation_id": { "type": "string", "format": "uuid" },
        "recalled_at":     { "type": "string", "format": "date-time" }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["event_id", "timestamp", "user_id"],
      "properties": {
        "event_id":       { "type": "string", "format": "uuid" },
        "timestamp":      { "type": "string", "format": "date-time" },
        "user_id":        { "type": "string", "format": "uuid" },
        "correlation_id": { "type": "string", "format": "uuid" }
      }
    }
  }
}
