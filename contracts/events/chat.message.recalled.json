{
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "chat.message.recalled",
  "description": "Runtime WS broadcast envelope when a message is recalled.",
  "type": "object",
  "required": ["event", "payload", "timestamp"],
  "properties": {
    "event": { "type": "string", "const": "chat.message.recalled" },
    "timestamp": { "type": "string", "format": "date-time" },
    "payload": {
      "type": "object",
      "required": ["id", "conversation_id", "is_recalled"],
      "properties": {
        "id":              { "type": "string", "format": "uuid" },
        "conversation_id": { "type": "string", "format": "uuid" },
        "is_recalled":     { "type": "boolean" },
        "edited_at":       { "type": ["string", "null"], "format": "date-time" }
      }
    }
  },
  "additionalProperties": true
}
