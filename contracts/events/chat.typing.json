{
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "chat.typing",
  "description": "Short-lived ephemeral event indicating that a user started or stopped typing. Not persisted to the database.",
  "type": "object",
  "required": ["event", "payload", "timestamp"],
  "properties": {
    "event": { "type": "string", "const": "chat.typing" },
    "timestamp": { "type": "string", "format": "date-time" },
    "payload": {
      "type": "object",
      "required": ["conversation_id", "user_id", "is_typing"],
      "properties": {
        "conversation_id": { "type": "string", "format": "uuid" },
        "user_id":         { "type": "string", "format": "uuid" },
        "is_typing":       { "type": "boolean" }
      }
    }
  },
  "additionalProperties": true
}
