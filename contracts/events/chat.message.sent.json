{
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "chat.message.sent",
  "description": "Runtime WS broadcast envelope for a persisted message (canonical format).",
  "type": "object",
  "required": ["event", "version", "payload", "metadata"],
  "properties": {
    "event": { "type": "string", "const": "chat.message.sent" },
    "version": { "type": "string", "const": "1.0" },
    "payload": {
      "type": "object",
      "required": ["id", "conversation_id", "content", "content_type", "created_at"],
      "properties": {
        "id":                { "type": "string", "format": "uuid" },
        "client_message_id": { "type": "string", "description": "Client-generated idempotency key" },
        "conversation_id":   { "type": "string", "format": "uuid" },
        "sender_id":         { "type": ["string", "null"], "format": "uuid" },
        "content":           { "type": "string" },
        "content_type":      { "type": "string", "enum": ["text", "image", "file", "audio", "system"] },
        "attachments":       {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "url":       { "type": "string", "format": "uri" },
              "mime_type": { "type": "string" },
              "size":      { "type": "integer" },
              "name":      { "type": "string" }
            }
          }
        },
        "reply_to_id": { "type": "string", "format": "uuid", "description": "ID of the message being replied to" },
        "created_at":  { "type": "string", "format": "date-time" },
        "edited_at":   { "type": ["string", "null"], "format": "date-time" },
        "is_recalled": { "type": "boolean" },
        "is_pinned":   { "type": "boolean" }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["event_id", "timestamp", "user_id"],
      "properties": {
        "event_id": { "type": "string", "format": "uuid" },
        "timestamp": { "type": "string", "format": "date-time" },
        "user_id": { "type": "string", "format": "uuid" },
        "correlation_id": { "type": "string", "format": "uuid" }
      }
    }
  }
}
