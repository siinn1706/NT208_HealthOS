{
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "chat.message.edited",
  "description": "Emitted when a message content is changed by its sender.",
  "type": "object",
  "required": ["event", "version", "payload", "metadata"],
  "properties": {
    "event": { "type": "string", "const": "chat.message.edited" },
    "version": { "type": "string", "const": "1.0" },
    "payload": {
      "type": "object",
      "required": ["message_id", "conversation_id", "new_content", "edited_at"],
      "properties": {
        "message_id":      { "type": "string", "format": "uuid" },
        "conversation_id": { "type": "string", "format": "uuid" },
        "new_content":     { "type": "string" },
        "edited_at":       { "type": "string", "format": "date-time" }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["event_id", "timestamp", "user_id"],
      "properties": {
        "event_id":       { "type": "string", "format": "uuid" },
        "timestamp":      { "type": "string", "format": "date-time" },
        "user_id":        { "type": "string", "format": "uuid" },
        "correlation_id": { "type": "string", "format": "uuid" }
      }
    }
  }
}
