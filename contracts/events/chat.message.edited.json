{
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "chat.message.edited",
  "description": "Runtime WS broadcast envelope for an edited message.",
  "type": "object",
  "required": ["event", "payload", "timestamp"],
  "properties": {
    "event": { "type": "string", "const": "chat.message.edited" },
    "timestamp": { "type": "string", "format": "date-time" },
    "payload": {
      "type": "object",
      "required": ["id", "conversation_id", "content", "edited_at"],
      "properties": {
        "id":              { "type": "string", "format": "uuid" },
        "conversation_id": { "type": "string", "format": "uuid" },
        "content":         { "type": "string" },
        "edited_at":       { "type": ["string", "null"], "format": "date-time" }
      }
    }
  },
  "additionalProperties": true
}
