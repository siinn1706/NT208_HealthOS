{
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "chat.message.reacted",
  "description": "Emitted when a user adds or removes an emoji reaction. `action` distinguishes add vs. remove (toggle behaviour).",
  "type": "object",
  "required": ["event", "version", "payload", "metadata"],
  "properties": {
    "event": { "type": "string", "const": "chat.message.reacted" },
    "version": { "type": "string", "const": "1.0" },
    "payload": {
      "type": "object",
      "required": ["message_id", "conversation_id", "user_id", "emoji", "action"],
      "properties": {
        "message_id":      { "type": "string", "format": "uuid" },
        "conversation_id": { "type": "string", "format": "uuid" },
        "user_id":         { "type": "string", "format": "uuid" },
        "emoji":           { "type": "string", "description": "Unicode emoji character, e.g. 👍" },
        "action":          { "type": "string", "enum": ["added", "removed"] }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["event_id", "timestamp", "user_id"],
      "properties": {
        "event_id":       { "type": "string", "format": "uuid" },
        "timestamp":      { "type": "string", "format": "date-time" },
        "user_id":        { "type": "string", "format": "uuid" },
        "correlation_id": { "type": "string", "format": "uuid" }
      }
    }
  }
}
