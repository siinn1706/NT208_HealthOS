{
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "chat.message.reacted",
  "description": "Runtime WS broadcast envelope after reaction toggle (canonical format).",
  "type": "object",
  "required": ["event", "version", "payload", "metadata"],
  "properties": {
    "event": { "type": "string", "const": "chat.message.reacted" },
    "version": { "type": "string", "const": "1.0" },
    "payload": {
      "type": "object",
      "required": ["id", "conversation_id", "reactions"],
      "properties": {
        "id":              { "type": "string", "format": "uuid" },
        "conversation_id": { "type": "string", "format": "uuid" },
        "reactions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "emoji": { "type": "string" },
              "user_id": { "type": "string", "format": "uuid" },
              "user_display_name": { "type": "string" }
            }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["event_id", "timestamp", "user_id"],
      "properties": {
        "event_id": { "type": "string", "format": "uuid" },
        "timestamp": { "type": "string", "format": "date-time" },
        "user_id": { "type": "string", "format": "uuid" },
        "correlation_id": { "type": "string", "format": "uuid" }
      }
    }
  }
}
