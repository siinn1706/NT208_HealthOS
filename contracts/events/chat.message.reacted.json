{
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "chat.message.reacted",
  "description": "Runtime WS broadcast envelope after reaction toggle.",
  "type": "object",
  "required": ["event", "payload", "timestamp"],
  "properties": {
    "event": { "type": "string", "const": "chat.message.reacted" },
    "timestamp": { "type": "string", "format": "date-time" },
    "payload": {
      "type": "object",
      "required": ["id", "conversation_id", "reactions"],
      "properties": {
        "id":              { "type": "string", "format": "uuid" },
        "conversation_id": { "type": "string", "format": "uuid" },
        "reactions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "emoji": { "type": "string" },
              "user_id": { "type": "string", "format": "uuid" },
              "user_display_name": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
