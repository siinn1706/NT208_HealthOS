            </>
          )}
        </View>
      </Card>

      <SectionHeader title="Health platforms" />
      <Card tight style={styles.listCard}>
        {platformRows.map((platform, index) => {
          const connected = devices.find((item) => item.provider === platform.id);
          return (
            <React.Fragment key={platform.id}>
              <DeviceRow
                name={platform.name}
                sub={platform.sub}
