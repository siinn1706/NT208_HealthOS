      <Pressable
        onPress={handleSend}
        style={[styles.send, { backgroundColor: t.brand, borderRadius: t.radius.pill }]}
        accessibilityLabel={i18n('chat.sendMessage')}
      >
        <IconSend size={18} color="#FFF" />
