export function DevicesHubScreen() {
  const t = useTheme();
  const [missingOpen, setMissingOpen] = useState(false);
  const [missingTitle, setMissingTitle] = useState('');
  const devicesQuery = useApiQuery(queryKeys.devices, () => deviceService.list());
