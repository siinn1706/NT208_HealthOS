        {slot.state === 'error' && <Text style={[typography.caption, { color: t.danger }]}>Upload failed — tap to retry</Text>}
        {slot.state === 'idle' && <Text style={[typography.caption, { color: t.ink4 }]}>Waiting…</Text>}
      </View>
    </View>
  );
}

const s = StyleSheet.create({
