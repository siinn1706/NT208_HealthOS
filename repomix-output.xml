  heroCircle:      { position: 'absolute', right: -40, top: -40, width: 160, height: 160, borderRadius: 80 },
  ringCenter:      { alignItems: 'center' },
  heroText:        { flex: 1, gap: 2 },
  macroGrid:       { flexDirection: 'row', gap: 8, marginBottom: 12 },
  macroCard:       { flex: 1 },
