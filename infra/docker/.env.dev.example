# Docker Compose dev defaults (reference only)
# infra/docker/.env.dev is generated from infra/env/.env.master.
POSTGRES_DB=healthos
POSTGRES_USER=healthos
POSTGRES_PASSWORD=healthos_dev_pass
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
NEXTAUTH_SECRET=dev-nextauth-secret-change-me
BFF_SHARED_SECRET=dev-bff-secret-change-in-production
# AI_WORKER_URL is intentionally omitted here so Docker dev uses ai-worker:8001.
# To point compose at a host-side worker, pass shell env:
#   AI_WORKER_URL=http://host.docker.internal:8001 docker compose ...
