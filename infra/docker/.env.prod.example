# Docker Compose production values (template only)
POSTGRES_DB=healthos
POSTGRES_USER=healthos
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me
STORAGE_ENDPOINT=http://minio:9000
NEXTAUTH_URL=https://your-domain.example
NEXTAUTH_SECRET=replace-with-openssl-rand-hex-32
NEXT_PUBLIC_CORE_WS_URL=wss://your-domain.example/ws
BFF_SHARED_SECRET=replace-with-openssl-rand-hex-32
METRICS_TOKEN=replace-with-openssl-rand-hex-32
