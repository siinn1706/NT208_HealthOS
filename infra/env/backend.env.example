# Core Backend Environment Variables
# Copy thành backend/.env

# Database
DATABASE_URL=postgresql+asyncpg://healthos:healthos_dev_pass@localhost:5432/healthos

# Redis
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO / S3)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_MEALS=meals
STORAGE_BUCKET_DOCS=medical-docs
STORAGE_USE_SSL=false

# Security
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
# Optional: JWT issuer/audience for validation
AUTH_ISSUER=healthos-core
AUTH_AUDIENCE=healthos-clients

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# Service URLs
AI_WORKER_URL=http://localhost:8001
CELERY_BROKER_URL=redis://localhost:6379/2

# App
DEBUG=true
LOG_LEVEL=info
