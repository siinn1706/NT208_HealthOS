# Core Backend Environment Variables
# Copy to backend/.env
# For staging/production, set APP_ENV and provide all required secrets.

# Environment mode (staging/production requires secrets)
# APP_ENV=staging
# APP_ENV=production
# NODE_ENV=production

# Database - REQUIRED in production
DATABASE_URL=postgresql+asyncpg://healthos:healthos_dev_pass@localhost:5432/healthos

# Redis (local default: no AUTH). If your Redis requires a password, embed it in the URL:
#   REDIS_URL=redis://:your_redis_password@localhost:6379/0
REDIS_URL=redis://localhost:6379/0
# Optional stray key — ignored for connections; remove or leave blank to avoid confusion with POSTGRES_PASSWORD.
# REDIS_PASSWORD=
# Docker mode sets REDIS_URL for containerized services in docker-compose; keep
# this template on no-auth defaults so local mode works out of the box.

# Object Storage (MinIO / S3) - REQUIRED in production
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_MEALS=meals
STORAGE_BUCKET_DOCS=medical-docs
STORAGE_USE_SSL=false

# Security - REQUIRED in production (min 32 chars)
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
# Optional: JWT issuer/audience for validation
AUTH_ISSUER=healthos-core
AUTH_AUDIENCE=healthos-clients

# CORS
ALLOWED_ORIGINS=["http://localhost:3000"]

# Service URLs
AI_WORKER_URL=http://localhost:8001
CELERY_BROKER_URL=redis://localhost:6379/2

# Email (SMTP) for OTP and notifications
# Để gửi OTP qua Gmail, bật 2-Step Verification rồi tạo App Password tại:
#   https://myaccount.google.com/apppasswords
# Dán 16-ký-tự App Password vào SMTP_PASSWORD (không dùng mật khẩu Gmail thường).
# Fill these in your local backend/.env — do NOT commit real credentials.
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_gmail@gmail.com
# SMTP_PASSWORD=xxxx xxxx xxxx xxxx    # Gmail 16-char App Password
# SMTP_USE_TLS=true

# BFF <-> Core BE shared secret for /v1/auth/token (C3 security fix)
# Must be set to a strong random value in staging/production.
# Same value must be set in frontend/.env.local.
# Generate: openssl rand -hex 32
BFF_SHARED_SECRET=dev-bff-secret-change-in-production

# App
DEBUG=true
LOG_LEVEL=info
# Log format: "text" (dev default) | "json" (production — machine-readable structured logs)
# LOG_FORMAT=json

# Metrics endpoint access control (Phase 1)
# Set METRICS_TOKEN to a strong secret for production scraping auth.
# METRICS_TOKEN=
# METRICS_ALLOW_LOCAL=true   # set to false in prod if scraper uses the token

# ── Wearable sync — Google Health API (Luồng B) ─────────────────────────
# OAuth client credentials. Obtain at:
#   https://console.cloud.google.com/  →  APIs & Services  →  Credentials
#   → Create OAuth 2.0 Client ID  →  Web app
# Authorized redirect URI to register must EXACTLY match GOOGLE_HEALTH_REDIRECT_URI.
# Leaving these blank disables the /v1/wearables/google/* endpoints (they
# return 503 with a clear message); useful for local dev without a Google
# project of your own.
#
# IMPORTANT: this flow stores Fernet-encrypted OAuth tokens on the
# `connected_devices` table. FERNET_KEY must be set (the helper in
# services/wearable_sync/token_crypto.py refuses to fall back to
# plaintext). The same key is reused by MFA — do NOT introduce a
# second one.
# GOOGLE_HEALTH_CLIENT_ID=
# GOOGLE_HEALTH_CLIENT_SECRET=
GOOGLE_HEALTH_REDIRECT_URI=http://localhost:3000/api/v1/wearables/google/callback
# HMAC secret for incoming Google Health webhook validation. Leave blank
# until Google enables webhooks for your account — the receiver rejects
# any request if the secret is empty.
# GOOGLE_HEALTH_WEBHOOK_SECRET=
# How often the Celery Beat poller drains pending Google Health data.
WEARABLE_SYNC_INTERVAL_MINUTES=15
