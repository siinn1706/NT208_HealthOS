# HealthOS master environment.
# Edit infra/env/.env.master, then run:
#   node infra/scripts/render-env.mjs --target all
#
# Generated service env files are overwritten by the renderer; do not edit them directly.
# For cloudflared/preview deploys, the values you usually change are grouped first.

# Quick edit: public/tunnel/deploy entrypoints (HTTP and WebSocket)
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
CORE_API_URL=http://localhost:8000
NEXT_PUBLIC_CORE_WS_URL=ws://localhost:8000
EXPO_PUBLIC_CORE_API_URL=http://192.168.1.10:8000
EXPO_PUBLIC_CORE_WS_URL=ws://192.168.1.10:8000
AI_WORKER_URL=http://localhost:8001
ALLOWED_ORIGINS=["http://localhost:3000"]
ALLOWED_DEV_ORIGINS=localhost,127.0.0.1,healthos-dev.example.com
BFF_TRUSTED_ORIGINS=
OAUTH_GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/oauth/google/callback
OAUTH_GOOGLE_LINK_CALLBACK_URL=http://localhost:3000/api/v1/auth/oauth/google/link/callback
OAUTH_GITHUB_CALLBACK_URL=http://localhost:3000/api/v1/auth/oauth/github/callback
OAUTH_GITHUB_LINK_CALLBACK_URL=http://localhost:3000/api/v1/auth/oauth/github/link/callback

# Runtime mode
APP_ENV=development
NODE_ENV=development
NEXT_PUBLIC_APP_ENV=dev
DEBUG=true
LOG_LEVEL=info
LOG_FORMAT=text

# Database, Redis, and Docker infrastructure
POSTGRES_DB=healthos
POSTGRES_USER=healthos
POSTGRES_PASSWORD=healthos_dev_pass
DATABASE_URL=postgresql+asyncpg://healthos:healthos_dev_pass@localhost:5432/healthos
DB_DISABLE_POOL=false
REDIS_PASSWORD=healthos_dev_pass
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Object storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_MEALS=meals
STORAGE_BUCKET_DOCS=medical-docs
STORAGE_USE_SSL=false

# Core security
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
AUTH_ISSUER=healthos-core
AUTH_AUDIENCE=healthos-clients
FERNET_KEY=
BFF_SHARED_SECRET=dev-bff-secret-change-in-production
BFF_EXCHANGE_ISSUER=healthos-bff
BFF_EXCHANGE_AUDIENCE=healthos-core
BFF_EXCHANGE_MAX_AGE_SECONDS=300
METRICS_TOKEN=
METRICS_ALLOW_LOCAL=true

# Frontend/BFF auth, cookies, and rate limiting
COOKIE_NAME=healthos.session
COOKIE_MAX_AGE=604800
COOKIE_SECURE=
REFRESH_COOKIE_NAME=healthos.refresh
REFRESH_COOKIE_MAX_AGE=2592000
TRUST_PROXY=0
BFF_CSRF_GUARD_MODE=enforce
NEXTAUTH_SECRET=dev-nextauth-secret-change-me
DEV_BYPASS_CREDENTIALS=

# OAuth provider secrets
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Public frontend feature flags
NEXT_PUBLIC_ONBOARDING_DRAFT_SERVER=
ADMIN_SECURITY_FEED_ENABLED=false
ADMIN_AUDIT_FEED_ENABLED=false

# Email and notification providers
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@healthos.example.com
SMTP_USE_TLS=true
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# AI worker
AI_MODEL_PATH=./models
AI_CONFIDENCE_THRESHOLD=0.6
AI_YOLO_TIMEOUT_SECONDS=15
AI_MAX_IMAGE_SIZE_PX=640
AI_YOLO_MODEL_PATH=./models/yolov10/YOLOv10b_VietFood67_SGD_new_bigger.pt
AI_YOLO_GDRIVE_FILE_ID=1n9tMmb2P5rAlIJsZrBB1wtjRmCKFreZc
AI_YOLO_MODEL_SHA256=
AI_CLASS_NAMES_PATH=./data/class_names.py
AI_REQUEST_TIMEOUT_SECONDS=30
AI_ALLOWED_IMAGE_HOSTS=
AI_IMAGE_DOWNLOAD_TIMEOUT_SECONDS=15
AI_BLOCK_PRIVATE_NETWORKS=true
AI_PROXY_BASE_URL=http://localhost:20128/v1
AI_PROXY_MODEL=oc/deepseek-v4-flash-free
AI_PROXY_API_KEY=
AI_PROXY_THINKING_MODE=disabled
AI_PROXY_REASONING_EFFORT=high
AI_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
AI_EMBEDDING_DIMENSION=384
AI_EMBEDDING_TIMEOUT_SECONDS=30
AI_CHAT_MAX_TOKENS=2048
AI_CHAT_TEMPERATURE=0.6
AI_CHAT_TIMEOUT_SECONDS=30
AI_CHAT_STREAM_CHUNK_MIN_CHARS=1
