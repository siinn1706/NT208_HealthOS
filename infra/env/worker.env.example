# Shared template for AI Worker, Queue Worker, and Notification services.
# setup.ps1 copies this to all three. Override per-service keys in the
# individual .env file after copy.
#
# Worker Environment Variables (AI Worker + Queue Worker + Notification)
# Copy thành services/<name>/.env

# Redis (broker & result backend)
REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Core BE (để worker gọi lại)
CORE_API_URL=http://localhost:8000

# AI Worker (để queue worker gọi)
AI_WORKER_URL=http://localhost:8001

# Object Storage
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_MEALS=meals
STORAGE_USE_SSL=false

# AI Models
AI_MODEL_PATH=./models
AI_CONFIDENCE_THRESHOLD=0.6
AI_YOLO_TIMEOUT_SECONDS=15
AI_MAX_IMAGE_SIZE_PX=640
AI_YOLO_MODEL_PATH=./models/yolov10/YOLOv10b_VietFood67_SGD_new_bigger.pt
AI_CLASS_NAMES_PATH=./data/class_names.py
AI_REQUEST_TIMEOUT_SECONDS=30
AI_ENABLE_GEMINI_FALLBACK=true
AI_GEMINI_TIMEOUT_SECONDS=20
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Notification
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@healthos.example.com
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# App
DEBUG=true
LOG_LEVEL=info
