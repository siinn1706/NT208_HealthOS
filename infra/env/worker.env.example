# Shared reference for AI Worker, Queue Worker, and Notification services.
# Service .env files are generated from infra/env/.env.master.
#
# Worker Environment Variables (AI Worker + Queue Worker + Notification)
# Copy thành services/<name>/.env

# Redis (broker & result backend)
REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Core BE (để worker gọi lại)
CORE_API_URL=http://localhost:8000

# AI Worker (để queue worker gọi)
AI_WORKER_URL=http://localhost:8001

# Object Storage
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_MEALS=meals
STORAGE_USE_SSL=false

# AI Models
AI_MODEL_PATH=./models
AI_CONFIDENCE_THRESHOLD=0.6
AI_YOLO_TIMEOUT_SECONDS=15
AI_MAX_IMAGE_SIZE_PX=640
AI_YOLO_MODEL_PATH=./models/yolov10/YOLOv10b_VietFood67_SGD_new_bigger.pt
AI_YOLO_GDRIVE_FILE_ID=1n9tMmb2P5rAlIJsZrBB1wtjRmCKFreZc
AI_YOLO_MODEL_SHA256=
AI_CLASS_NAMES_PATH=./data/class_names.py
AI_REQUEST_TIMEOUT_SECONDS=30
AI_ALLOWED_IMAGE_HOSTS=
AI_IMAGE_DOWNLOAD_TIMEOUT_SECONDS=15
AI_BLOCK_PRIVATE_NETWORKS=true
AI_PROXY_BASE_URL=http://localhost:20128/v1
AI_PROXY_MODEL=oc/deepseek-v4-flash-free
AI_PROXY_API_KEY=
AI_CHAT_MAX_TOKENS=2048
AI_CHAT_TEMPERATURE=0.6
AI_CHAT_TIMEOUT_SECONDS=30
AI_CHAT_STREAM_CHUNK_MIN_CHARS=1

# Notification
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@healthos.example.com
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# App
DEBUG=true
LOG_LEVEL=info
# TODO(post-deploy-safety): adopt shared JSON logging stack across worker services
# (LOG_FORMAT not added here — workers live outside backend/ and do not import
#  app.core.logging_setup; revisit when a shared logging package is extracted)
