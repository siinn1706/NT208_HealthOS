# Frontend / BFF Environment Variables
# Reference only: frontend/.env.local is generated from infra/env/.env.master.

# URL nội bộ để BFF gọi Core BE (không expose ra browser)
CORE_API_URL=http://localhost:8000

# BFF auth cookie (shared by auth routes, middleware, and proxy)
COOKIE_NAME=healthos.session
COOKIE_MAX_AGE=604800

# NextAuth
NEXTAUTH_URL=http://localhost:3000
# openssl rand -base64 32
NEXTAUTH_SECRET=dev-nextauth-secret-change-me

# ─── OAuth Providers ──────────────────────────────────────────────────────────
# Runtime callback generation now prefers the forwarded/request origin and uses
# the env callback URLs only as fallback values. For public OAuth testing, set
# `ALLOWED_DEV_ORIGINS` to include hostname entries for your stable named
# Cloudflare tunnel and register BOTH localhost and the stable tunnel callback
# URLs in the provider consoles. You may add `*.trycloudflare.com` for temporary
# HMR access, but rotating tunnel hostnames still require redirect-URI updates
# whenever the hostname changes.
ALLOWED_DEV_ORIGINS=localhost,127.0.0.1,healthos-dev.example.com

# Google OAuth 2.0
# Tạo credentials tại: https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs:
#   - http://localhost:3000/api/v1/auth/oauth/google/callback
#   - https://healthos-dev.example.com/api/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/oauth/google/callback

# GitHub OAuth
# Tạo OAuth App tại: https://github.com/settings/developers
# Authorization callback URLs:
#   - http://localhost:3000/api/v1/auth/oauth/github/callback
#   - https://healthos-dev.example.com/api/v1/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_CALLBACK_URL=http://localhost:3000/api/v1/auth/oauth/github/callback
# BFF <-> Core BE shared secret for /v1/auth/token (C3 security fix)
# Must match BFF_SHARED_SECRET in backend/.env. Generate: openssl rand -hex 32
# Keep server-only; do NOT expose with NEXT_PUBLIC_*.
BFF_SHARED_SECRET=dev-bff-secret-change-in-production

# Public vars — expose ra browser (prefix NEXT_PUBLIC_)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# WebSocket endpoint consumed by frontend hooks. In dev, `npm run dev` forwards
# same-origin /ws and /v1/** WebSocket upgrades to CORE_API_URL.
NEXT_PUBLIC_CORE_WS_URL=ws://localhost:8000
