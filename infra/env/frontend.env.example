# Frontend / BFF Environment Variables
# Copy thành frontend/.env.local

# URL nội bộ để BFF gọi Core BE (không expose ra browser)
CORE_API_URL=http://localhost:8000

# BFF auth cookie (shared by auth routes, middleware, and proxy)
COOKIE_NAME=healthos.session
COOKIE_MAX_AGE=604800

# NextAuth
NEXTAUTH_URL=http://localhost:3000
# openssl rand -base64 32
NEXTAUTH_SECRET=dev-nextauth-secret-change-me

# ─── OAuth Providers ──────────────────────────────────────────────────────────
# Google OAuth 2.0
# Tạo credentials tại: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/oauth/google/callback

# GitHub OAuth
# Tạo OAuth App tại: https://github.com/settings/developers
# Authorization callback URL: http://localhost:3000/api/v1/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_CALLBACK_URL=http://localhost:3000/api/v1/auth/oauth/github/callback

# Public vars — expose ra browser (prefix NEXT_PUBLIC_)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# WebSocket endpoint consumed by frontend hooks
NEXT_PUBLIC_CORE_WS_URL=ws://localhost:8000