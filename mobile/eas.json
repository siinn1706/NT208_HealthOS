{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "env": {
        "EXPO_PUBLIC_BUILD_CHANNEL": "dev",
        "EXPO_PUBLIC_CORE_API_URL": "http://10.0.2.2:8000",
        "EXPO_PUBLIC_CORE_WS_URL": "ws://10.0.2.2:8000",
        "EXPO_PUBLIC_AI_FEATURES_ENABLED": "false"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_BUILD_CHANNEL": "staging",
        "EXPO_PUBLIC_CORE_API_URL": "https://staging-api.healthos.local",
        "EXPO_PUBLIC_CORE_WS_URL": "wss://staging-api.healthos.local",
        "EXPO_PUBLIC_AI_FEATURES_ENABLED": "false"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_BUILD_CHANNEL": "prod",
        "EXPO_PUBLIC_CORE_API_URL": "https://api.healthos.local",
        "EXPO_PUBLIC_CORE_WS_URL": "wss://api.healthos.local",
        "EXPO_PUBLIC_AI_FEATURES_ENABLED": "false"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
