# HealthOS mobile talks directly to Core API with bearer-token auth.
# Do not put secrets in this file. Expo exposes EXPO_PUBLIC_* values to the app bundle.

# Local emulator default:
# Leave these blank for simulator/emulator workflows. Android emulator still
# falls back to 10.0.2.2 automatically.
EXPO_PUBLIC_CORE_API_URL=
EXPO_PUBLIC_CORE_WS_URL=
EXPO_PUBLIC_WEB_APP_URL=

# Android emulator explicit override, rarely needed:
# EXPO_PUBLIC_CORE_API_URL=http://10.0.2.2:8000
# EXPO_PUBLIC_CORE_WS_URL=ws://10.0.2.2:8000
# EXPO_PUBLIC_WEB_APP_URL=http://10.0.2.2:3000

# Physical Android/iOS device on the same LAN:
# Replace this with your computer's LAN IP, not localhost.
# Start Core with: ..\start_BE.bat -Host 0.0.0.0
# In dev, npm run android requires these explicit LAN values for a physical
# Android phone; blank values are accepted only for emulator/simulator flows.
# EXPO_PUBLIC_CORE_API_URL=http://192.168.1.10:8000
# EXPO_PUBLIC_CORE_WS_URL=ws://192.168.1.10:8000
# EXPO_PUBLIC_WEB_APP_URL=http://192.168.1.10:3000

# Production/staging:
# Use HTTPS/WSS with a real hostname and valid TLS certificate.
# EXPO_PUBLIC_CORE_API_URL=https://api.healthos.example.com
# EXPO_PUBLIC_CORE_WS_URL=wss://api.healthos.example.com
# EXPO_PUBLIC_WEB_APP_URL=https://healthos.example.com
# EAS_PROJECT_ID=<expo-project-uuid>

# Optional runtime flag for hiding incomplete features in release builds.
# Use development, staging, or production.
# EXPO_PUBLIC_APP_ENV=development
