# HealthOS mobile calls the Next.js BFF API (/api/v1) via bearer-token auth.
# Do not put secrets in this file. Expo exposes EXPO_PUBLIC_* values to the app bundle.

# All mobile REST traffic goes through the Next.js BFF at /api/v1/**.
# Point EXPO_PUBLIC_API_URL at the BFF, NOT at Core BE port 8000.

# Migration note (Q2 2026):
# If you previously used EXPO_PUBLIC_CORE_API_URL, rename it to
# EXPO_PUBLIC_API_URL. The mobile app still reads the legacy name as a
# fallback and will print a one-time console warning in dev — but the
# legacy name will be removed in a future release.

# Local emulator default:
# Leave these blank; the app auto-detects the LAN IP from the Expo manifest.
# Android emulator falls back to 10.0.2.2:3000 automatically.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_WS_URL=
# DEPRECATED: EXPO_PUBLIC_CORE_WS_URL → EXPO_PUBLIC_WS_URL (removed next release)
EXPO_PUBLIC_CORE_WS_URL=
EXPO_PUBLIC_WEB_APP_URL=

# Android emulator explicit override, rarely needed:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
# EXPO_PUBLIC_WS_URL=ws://10.0.2.2:8000
# EXPO_PUBLIC_CORE_WS_URL=ws://10.0.2.2:8000  # DEPRECATED 2026-09-01
# EXPO_PUBLIC_WEB_APP_URL=http://10.0.2.2:3000

# Physical Android/iOS device on the same LAN:
# Replace with your computer's LAN IP. Start BFF with: ..\start_FE.bat
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
# EXPO_PUBLIC_WS_URL=ws://192.168.1.10:8000
# EXPO_PUBLIC_CORE_WS_URL=ws://192.168.1.10:8000  # DEPRECATED 2026-09-01
# EXPO_PUBLIC_WEB_APP_URL=http://192.168.1.10:3000

# Production:
# Mobile API must go through the BFF — never directly to Core port 8000.
# WebSocket base origin only — no /ws suffix; clients append path themselves.
# EXPO_PUBLIC_API_URL=https://healthos.shop
# EXPO_PUBLIC_WS_URL=wss://healthos.shop
# EXPO_PUBLIC_CORE_WS_URL=wss://healthos.shop  # DEPRECATED 2026-09-01
# EXPO_PUBLIC_WEB_APP_URL=https://healthos.io.vn
# EAS_PROJECT_ID=<expo-project-uuid>

# Optional runtime flag for hiding incomplete features in release builds.
# Use development, staging, or production.
# EXPO_PUBLIC_APP_ENV=development
