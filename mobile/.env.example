# HealthOS mobile calls the Next.js BFF at /api via bearer-token auth.
# Do not put secrets in this file. Expo exposes EXPO_PUBLIC_* values to the app bundle.

# Local emulator default:
# Leave these blank; the app auto-detects the LAN IP from the Expo manifest.
# Android emulator falls back to 10.0.2.2:3000 automatically.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_CORE_WS_URL=
EXPO_PUBLIC_WEB_APP_URL=

# Android emulator explicit override, rarely needed:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
# EXPO_PUBLIC_CORE_WS_URL=ws://10.0.2.2:8000
# EXPO_PUBLIC_WEB_APP_URL=http://10.0.2.2:3000

# Physical Android/iOS device on the same LAN:
# Replace with your computer's LAN IP. Start BFF with: ..\start_FE.bat
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
# EXPO_PUBLIC_CORE_WS_URL=ws://192.168.1.10:8000
# EXPO_PUBLIC_WEB_APP_URL=http://192.168.1.10:3000

# Production:
# Mobile API must go through the BFF — never directly to Core port 8000.
# WebSocket is forwarded by the reverse proxy: wss://healthos.page/ws → core-be:8000/ws
# EXPO_PUBLIC_API_URL=https://healthos.page/api
# EXPO_PUBLIC_CORE_WS_URL=wss://healthos.page
# EXPO_PUBLIC_WEB_APP_URL=https://healthos.page
# EAS_PROJECT_ID=<expo-project-uuid>

# Optional runtime flag for hiding incomplete features in release builds.
# Use development, staging, or production.
# EXPO_PUBLIC_APP_ENV=development
