FROM node:20-bookworm-slim AS base

ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /app

COPY package.json package-lock.json .npmrc ./
RUN npm ci

COPY . .

FROM base AS dev
EXPOSE 3000
CMD ["npm", "run", "dev", "--", "--hostname", "0.0.0.0", "--port", "3000"]

FROM base AS prod
ARG APP_ENV
ARG NEXT_PUBLIC_APP_ENV
ARG BFF_TRUSTED_ORIGINS
ARG BFF_CSRF_GUARD_MODE
ARG DEV_BYPASS_ENABLED
ARG DEV_BYPASS_CREDENTIALS
RUN APP_ENV="$APP_ENV" NEXT_PUBLIC_APP_ENV="$NEXT_PUBLIC_APP_ENV" BFF_TRUSTED_ORIGINS="$BFF_TRUSTED_ORIGINS" BFF_CSRF_GUARD_MODE="$BFF_CSRF_GUARD_MODE" DEV_BYPASS_ENABLED="$DEV_BYPASS_ENABLED" DEV_BYPASS_CREDENTIALS="$DEV_BYPASS_CREDENTIALS" npm run build
ENV NODE_ENV=production
EXPOSE 3000
CMD ["npm", "run", "start", "--", "-H", "0.0.0.0", "-p", "3000"]

