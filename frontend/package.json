{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node tools/dev-proxy-server.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint && npm run lint:no-legacy-host && npm run check:no-direct-core",
    "lint:no-legacy-host": "bash scripts/check-no-legacy-host.sh",
    "check:no-direct-core": "node scripts/check-no-direct-core.mjs",
    "check:route-matrix": "node scripts/check-route-matrix.mjs",
    "optimize:assets": "node tools/optimize-assets.mjs",
    "optimize:svgo": "node tools/optimize-assets.mjs --svgo",
    "optimize:thumbs": "node tools/optimize-assets.mjs --thumbs",
    "i18n:check": "node tools/check-i18n-parity.mjs",
    "i18n:scan:locale": "grep -rn \"vi-VN\\|en-US\" src/ --include=\"*.tsx\" --include=\"*.ts\" || true",
    "i18n:scan:vi": "grep -rPn \"[\\x{1E00}-\\x{1EFF}\\x{00C0}-\\x{024F}]\" src/app/ src/components/ src/lib/ --include=\"*.tsx\" --include=\"*.ts\" || true",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:prod": "PLAYWRIGHT_BASE_URL=https://healthos.io.vn playwright test seo-production-smoke"
  },
  "dependencies": {
    "@dayflow/blossom-color-picker": "^2.2.0",
    "@dayflow/blossom-color-picker-react": "^1.2.0",
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-slider": "^1.3.6",
    "@tailwindcss/typography": "^0.5.19",
    "@twallpaper/react": "^2.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.6",
    "emoji-mart": "^5.6.0",
    "framer-motion": "^12.34.3",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.575.0",
    "next": "16.1.6",
    "next-intl": "^4.8.3",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.2",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.3",
    "redis": "^4.6.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.2.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "canvas": "^3.2.2",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^3.23.2",
    "jsdom": "^29.0.1",
    "postcss": "^8.5.6",
    "shadcn": "^3.8.5",
    "sharp": "^0.34.5",
    "svgo": "^4.0.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.1"
  }
}
